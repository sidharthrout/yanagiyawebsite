# ============================================================
# Yanagiya — .htaccess
# ============================================================

# デフォルトページを reservation.html に設定（URLから /reservation.html を省略）
DirectoryIndex reservation.html

# ディレクトリ一覧の表示を禁止
Options -Indexes

# ============================================================
# セキュリティヘッダー
# ============================================================

<IfModule mod_headers.c>
  # クリックジャッキング対策（iframeへの埋め込みを禁止）
  Header always set X-Frame-Options "DENY"

  # MIMEタイプスニッフィング対策
  Header always set X-Content-Type-Options "nosniff"

  # XSS保護（古いブラウザ向け）
  Header always set X-XSS-Protection "1; mode=block"

  # リファラー情報の制限（外部サイトへの情報漏えい防止）
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # HTTPS強制（HSTS）— SSL証明書が有効な場合のみ有効
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ============================================================
# 機密ファイルへの直接アクセスを禁止
# ============================================================

# gas-code.js はサーバー管理用メモのため直接閲覧禁止
<Files "gas-code.js">
  Order allow,deny
  Deny from all
</Files>

# .htaccess 自体への直接アクセスを禁止
<Files ".htaccess">
  Order allow,deny
  Deny from all
</Files>
